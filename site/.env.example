# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs, Open Graph tags, and the sitemap.
# Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: webhook URL (Zapier, CRM, etc.) that receives a POST with
# every lead submitted through the contact form. If unset, leads are
# only logged to the server console.
LEAD_WEBHOOK_URL=
